# ==========================================
# VPN Live Dev - Environment Configuration
# ==========================================

# --- DOMAIN & GENERAL ---
DOMAIN=vpn.live-dev.by
SITE_URL=http://vpn.live-dev.by
SECRET_KEY=generate-a-strong-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=vpn.live-dev.by,localhost,127.0.0.1,web

# --- POSTGRES DATABASE ---
DB_NAME=vpn_db
DB_USER=vpn_user
DB_PASSWORD=vpn_secure_password_123
DB_HOST=db
DB_PORT=5432

# --- REDIS CACHE & TASKS ---
REDIS_URL=redis://redis:6379/0

# --- TELEGRAM BOT ---
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
BOT_USERNAME=vpn_livedev_bot
TELEGRAM_WEBAPP_URL=http://vpn.live-dev.by/miniapp/

# --- EMAIL SETTINGS (Password Reset & Notifications) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=support@live-dev.by
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL="VPN Live Dev" <support@live-dev.by>

# --- 3X-UI / XRAY VPN NODE SETTINGS ---
# Settings of your foreign VPS (Netherlands / Germany)
XRAY_HOST=http://your-node-ip:2053
XRAY_WEB_BASE_PATH=/
XRAY_USER=admin
XRAY_PASSWORD=your_3xui_password
XRAY_INBOUND_ID=1
XRAY_SERVER_NAME=Netherlands-01
XRAY_PUBLIC_IP=your-node-ip
XRAY_PUBLIC_PORT=443
XRAY_SNI=www.microsoft.com
XRAY_PBK=your_reality_public_key
XRAY_SHORT_ID=your_short_id
XRAY_SPIDER_X=/

# --- BILLING & PAYMENTS ---
DAILY_TARIFF_RUB=3.50
TRIAL_DAYS=3
MOCK_PAYMENTS=True
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
CRYPTOBOT_TOKEN=
